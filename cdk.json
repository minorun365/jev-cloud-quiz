{
  "app": "npx tsx infra/bin/app.ts",
  "output": "cdk.out",
  "watch": {
    "include": ["infra/**/*.ts", "server/**", "src/**"],
    "exclude": ["node_modules", "cdk.out", "dist", ".git"]
  },
  "context": {
    "@aws-cdk/core:validateAgainstDefaultRules": true,
    "cdkd": { "statePrefix": "jev-classifier" }
  }
}
