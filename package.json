{
  "name": "jev-cloud-classifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "serve": "npm run build && node --env-file-if-exists=.env server/server.mjs",
    "infra:synth": "cdkd synth",
    "infra:diff": "cdkd diff",
    "infra:dry-run": "cdkd deploy --all --dry-run",
    "infra:deploy": "cdkd deploy --full-wait",
    "infra:local": "cdkd local start-cloudfront JevClassifier/Distribution --watch --port 8080",
    "serve:only": "node --env-file-if-exists=.env server/server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1063.0",
    "@typesafe-ai/sdk": "0.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@go-to-k/cdkd": "0.290.33",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "aws-cdk": "2.1136.0",
    "aws-cdk-lib": "^2.264.0",
    "constructs": "^10.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.14"
  }
}
